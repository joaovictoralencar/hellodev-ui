{
  "description": "A modular UI system for Unity games. Provides container-based UI management, custom selectables, and styling components.",
  "displayName": "HelloDev UI",
  "keywords": [
    "ui",
    "containers",
    "selectables",
    "buttons",
    "toggles"
  ],
  "dependencies": {
    "com.hellodev.utils": "1.0.7",
    "com.unity.textmeshpro": "3.0.0",
    "com.unity.localization": "1.5.12",
    "com.kyrylokuzyk.primetween": "1.4.8"
  },
  "samples": [
    {
      "displayName": "Base Prefabs (Optional)",
      "description": "Base UI prefabs (no Input System required).",
      "path": "Samples~/Prefabs"
    },
    {
      "displayName": "Input Prefabs (Requires Input System & com.hellodev.input)",
      "description": "Input-specific prefabs that require Unity Input System and the com.hellodev.input package. Import only if you have those packages installed.",
      "path": "Samples~/InputButtons"
    }
  ],
  "unity": "6000.0",
